<mxfile host="app.diagrams.net" pages="2">
  <diagram name="1 Overview" id="overview">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Valtuus: a governed interface for agent purchasing" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Open to any agent. Controlled by the buyer. Auditable by both sides." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cBuyer" value="Buyer (hotel, school, hospital)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="260" height="420" as="geometry" />
        </mxCell>
        <mxCell id="bStaff" value="&lt;b&gt;Kitchen staff&lt;/b&gt;&lt;br&gt;&quot;1,000 L lactose free milk by Monday&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bAgent" value="&lt;b&gt;Buyer&#39;s AI agent&lt;/b&gt;&lt;br&gt;Any agent: Claude, ChatGPT, own" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bMain" value="&lt;b&gt;Main user&lt;/b&gt;&lt;br&gt;Sets the limits, approves on the phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cGate" value="Valtuus gateway (on Valio Aimo&#39;s side, no LLM inside)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="gApi" value="&lt;b&gt;Open API&lt;/b&gt;&lt;br&gt;REST and MCP, agent key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gPage" value="&lt;b&gt;Approval page&lt;/b&gt;&lt;br&gt;Login, one tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="360" y="420" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gSearch" value="&lt;b&gt;Product search&lt;/b&gt;&lt;br&gt;Candidates from the product data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gOffer" value="&lt;b&gt;Signed offers&lt;/b&gt;&lt;br&gt;Fixed price, stock, order deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gRules" value="&lt;b&gt;Buyer&#39;s rules (mandate)&lt;/b&gt;&lt;br&gt;Limits, brands, allergens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="580" y="300" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gDecide" value="&lt;b&gt;Decision: agent or person&lt;/b&gt;&lt;br&gt;Same input, same answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="220" height="56" as="geometry" />
