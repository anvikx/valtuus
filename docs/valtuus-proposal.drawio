        <mxCell id="e7" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vStaff" target="gRecord">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr1" value="&lt;b&gt;The buyer trusts the agent&lt;/b&gt;&lt;br&gt;Limits are code. A person approves the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tr2" value="&lt;b&gt;The agent trusts the data&lt;/b&gt;&lt;br&gt;Signed offers: price, stock, deadline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tr3" value="&lt;b&gt;Valio Aimo trusts the order&lt;/b&gt;&lt;br&gt;Known agent, buyer&#39;s rules, shared record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" vertex="1" parent="1">
