        <mxCell id="ov17" edge="1" parent="1" source="ov13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=3;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" target="ov14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov18" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;dashed=1;" value="What Valio Aimo gets" vertex="1">
          <mxGeometry height="470" width="240" x="960" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ov19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Orders it can accept&lt;/b&gt;&lt;br&gt;Known agent, the buyer&#39;s rules, a signed confirmation" vertex="1">
          <mxGeometry height="110" width="200" x="980" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ov20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Demand it could not meet&lt;/b&gt;&lt;br&gt;Searches with no match, products refused and why" vertex="1">
          <mxGeometry height="110" width="200" x="980" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ov21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;One shared record&lt;/b&gt;&lt;br&gt;Every step in plain words, for the buyer and for Valio Aimo" vertex="1">
          <mxGeometry height="110" width="200" x="980" y="435" as="geometry" />
        </mxCell>
        <mxCell id="ov22" edge="1" parent="1" source="ov4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" target="ov5" value="">
