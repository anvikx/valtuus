        <mxCell id="vStaff" value="&lt;b&gt;Valio Aimo staff&lt;/b&gt;&lt;br&gt;Read orders and unmet demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="1">
