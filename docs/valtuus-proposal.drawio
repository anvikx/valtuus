  </diagram>
  <diagram name="2 From request to offer" id="req">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req1" value="From a vague request to the right offer" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="req2" value="The gateway gives facts. The agent asks only when the answer changes the product. The buyer&#39;s rules decide." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req3" value="&lt;b&gt;1 Buyer&#39;s words&lt;/b&gt;&lt;br&gt;&quot;Lactose free milk, 1,000 L, by Monday&quot;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="req4" value="&lt;b&gt;2 Agent reads it&lt;/b&gt;&lt;br&gt;Product words, must have attributes, quantity, unit, date" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="req5" value="&lt;b&gt;3 Gateway search&lt;/b&gt;&lt;br&gt;17,546 products in memory, 3 languages. Groups the hits by category" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="req6" value="Product clear?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="125" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="req7" value="&lt;b&gt;4 Signed offers&lt;/b&gt;&lt;br&gt;Price and stock for 40 candidates. Reject rules, ranking, split" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="req8" value="&lt;b&gt;5 Agent picks&lt;/b&gt;&lt;br&gt;Cheapest offer of the product asked for. Says why" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="req9" value="&lt;b&gt;One question&lt;/b&gt;&lt;br&gt;Options from the category groups the search found" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="req10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req3" target="req4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req4" target="req5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req5" target="req6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req6" target="req7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req7" target="req8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#854F0B;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req6" target="req9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="req16" value="search again in that category" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#854F0B;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="req9" target="req5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="535" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="req17" value="No LLM in the gateway. Search uses no Valio API call, so the agent searches as often as it needs. Only the 40 candidates get a price and stock call." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="860" y="290" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="req18" value="Clear request: no question" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="570" height="210" as="geometry" />
        </mxCell>
        <mxCell id="req19" value="&lt;b&gt;&quot;1,000 L lactose free milk by Monday&quot;&lt;/b&gt;&lt;br&gt;&amp;#8226; 72 hits. Milks are the largest group, so the product is clear&lt;br&gt;&amp;#8226; 40 candidates priced, rejected ones with a reason&lt;br&gt;&amp;#8226; Pick: Valio Arki Eila 1 l at 1.01 EUR per litre&lt;br&gt;&amp;#8226; Coffee milk and chocolate milk are skipped: not asked for" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="60" y="455" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="req20" value="Unclear request: one question" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#412402;" vertex="1" parent="1">
          <mxGeometry x="630" y="420" width="570" height="210" as="geometry" />
        </mxCell>
        <mxCell id="req21" value="&lt;b&gt;&quot;Cream for 200 portions by Friday&quot;&lt;/b&gt;&lt;br&gt;&amp;#8226; 593 hits in 72 categories. Ice cream is the largest group&lt;br&gt;&amp;#8226; Agent asks: &quot;Which one: whipping or cooking cream, cream cheese, ice cream?&quot;&lt;br&gt;&amp;#8226; Buyer: whipping. Agent searches &quot;whipping cream&quot; in the cream category&lt;br&gt;&amp;#8226; Then the same offers and rules as above" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="650" y="455" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="req22" value="Tricky products in the real Valio Aimo data, and what we do" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="655" width="1160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="req23" value="&lt;b&gt;&quot;milkdrink&quot; in one word&lt;/b&gt;&lt;br&gt;Arla 469363. Words match inside words, so &quot;milk&quot; finds it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req24" value="&lt;b&gt;&quot;Milk free&quot; margarine&lt;/b&gt;&lt;br&gt;Has the word milk. A negation after the word removes it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="695" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req25" value="&lt;b&gt;&quot;5 x Arla 1 L&quot;&lt;/b&gt;&lt;br&gt;The size comes from the unit data, not the name. 5 L, not 25 L" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="695" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req26" value="&lt;b&gt;Brand &quot;Arla &quot; with a space&lt;/b&gt;&lt;br&gt;Brand compare trims spaces and ignores case" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="925" y="695" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req27" value="&lt;b&gt;Stock 999999&lt;/b&gt;&lt;br&gt;Amount not known. Offered as &quot;not confirmed&quot;. A person decides" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req28" value="&lt;b&gt;API date Monday, deadline passed&lt;/b&gt;&lt;br&gt;Refused with the reason, and what can arrive instead" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="800" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req29" value="&lt;b&gt;&quot;laktoositon maito&quot;&lt;/b&gt;&lt;br&gt;Webshop: 0 results. We search the en, fi and sv names" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="800" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req30" value="&lt;b&gt;&quot;oat milk&quot;&lt;/b&gt;&lt;br&gt;The product is named &quot;Oat Drink&quot;. The agent tries other words" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="925" y="800" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="req31" value="&lt;b&gt;Every case above is one automated test on the real product file.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="1160" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Open standards" id="std">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="std1" value="Open standards: any agent can connect, anyone can check" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="std2" value="One service behind each operation. The MCP tool and the REST route call the same code." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="std3" value="Used in the prototype" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="560" height="470" as="geometry" />
        </mxCell>
        <mxCell id="std4" value="&lt;b&gt;MCP (Model Context Protocol)&lt;/b&gt;&lt;br&gt;Agent tools at /api/mcp. Any MCP client connects: Claude, ChatGPT, own agents" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std5" value="&lt;b&gt;OpenAPI 3&lt;/b&gt;&lt;br&gt;REST at /api/v1, the source of truth. Spec at /api/openapi.json" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std6" value="&lt;b&gt;Planned: JWS with EdDSA (RFC 7515, RFC 8037)&lt;/b&gt;&lt;br&gt;Offers and order confirmations will be signed with Ed25519. Today the page says Not signed yet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std7" value="&lt;b&gt;Planned: JWKS (RFC 7517)&lt;/b&gt;&lt;br&gt;Public key at /.well-known/jwks.json, so anyone can verify a signature" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std8" value="&lt;b&gt;GS1 GTIN&lt;/b&gt;&lt;br&gt;Products by GTIN. The order line uses the GTIN of the sales unit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std9" value="&lt;b&gt;Idempotency-Key header (IETF draft)&lt;/b&gt;&lt;br&gt;A retried checkout never gives a second order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="std10" value="Maps to AP2 (Agent Payments Protocol) ideas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#26215C;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="560" height="470" as="geometry" />
        </mxCell>
        <mxCell id="std11" value="AP2 idea" style="fillColor=#444441;strokeColor=#444441;fontColor=#FFFFFF;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="std12" value="Valtuus today" style="fillColor=#444441;strokeColor=#444441;fontColor=#FFFFFF;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="150" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="std13" value="Step to AP2" style="fillColor=#444441;strokeColor=#444441;fontColor=#FFFFFF;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="150" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="std14" value="Intent mandate: what the agent may do" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="184" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std15" value="The buyer&#39;s mandate: typed limits, versioned" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="184" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std16" value="The buyer signs it, the gateway verifies" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="184" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std17" value="Cart mandate: approve one exact cart" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="254" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std18" value="Approval of a cart that cannot change" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="254" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std19" value="The approval becomes a signature" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="254" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std20" value="Signed merchant statements" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="324" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std21" value="Signed offers and confirmations (JWS)" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="324" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std22" value="Same content as verifiable credentials" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="324" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std23" value="Payment mandate" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="394" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std24" value="None. No payment in scope" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="394" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std25" value="Outside the challenge" style="fillColor=#FFFFFF;strokeColor=#D3D1C7;fontColor=#2C2C2A;fontSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="394" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="std26" value="States and rules stay the same on the way to AP2. We use the ideas, and we do not call the prototype AP2 compliant." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="660" y="474" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="std27" value="Next, when Valio Aimo chooses a standard" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="std28" value="&lt;b&gt;Discovery file&lt;/b&gt;&lt;br&gt;/.well-known/agent-trade.json (RFC 8615): where the API, MCP and keys are" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="std29" value="&lt;b&gt;UCP or ACP profile&lt;/b&gt;&lt;br&gt;Publish the same operations in the commerce profile Valio Aimo picks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="345" y="650" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="std30" value="&lt;b&gt;Verifiable credentials&lt;/b&gt;&lt;br&gt;Product claims (allergens, origin, price) as W3C VCs on GS1 data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="650" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="std31" value="&lt;b&gt;MCP Apps&lt;/b&gt;&lt;br&gt;The approval card inside the agent app, not only on our page" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="915" y="650" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="std32" value="&lt;b&gt;Why not a full standard today&lt;/b&gt;&lt;br&gt;The brief leaves the choice open, AP2 is built around payment, and a partial copy of a spec is worse than an honest own design." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1160" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 Purchase flow" id="flow">
    <mxGraphModel dx="1228" dy="1025" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f0" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#2C2C2A;" value="One purchase, from request to order" vertex="1">
          <mxGeometry height="40" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="f0b" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#5F5E5A;" value="The four steps from Valio Aimo&#39;s brief: Request, Lookup, Order, Approval." vertex="1">
          <mxGeometry height="30" width="1100" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=13;fontColor=#2C2C2A;" value="&lt;b&gt;1 Request&lt;/b&gt;&lt;br&gt;The buyer asks the agent in plain words" vertex="1">
          <mxGeometry height="80" width="190" x="40" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" value="&lt;b&gt;2 Lookup&lt;/b&gt;&lt;br&gt;Search, then signed offers for all candidates" vertex="1">
          <mxGeometry height="80" width="190" x="270" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" value="&lt;b&gt;3 Order&lt;/b&gt;&lt;br&gt;The agent builds a cart at the fixed price" vertex="1">
          <mxGeometry height="80" width="190" x="500" y="190" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" value="&lt;b&gt;4 Approval&lt;/b&gt;&lt;br&gt;Inside the buyer&#39;s rules?" vertex="1">
          <mxGeometry height="120" width="190" x="730" y="170" as="geometry" />
        </mxCell>
        <mxCell id="yes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" value="&lt;b&gt;The agent places the order&lt;/b&gt;&lt;br&gt;No person needed" vertex="1">
          <mxGeometry height="70" width="210" x="980" y="110" as="geometry" />
        </mxCell>
        <mxCell id="no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=13;fontColor=#26215C;" value="&lt;b&gt;The main user approves&lt;/b&gt;&lt;br&gt;One tap on the phone, or reject with a reason" vertex="1">
          <mxGeometry height="70" width="210" x="980" y="280" as="geometry" />
        </mxCell>
        <mxCell id="done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=13;fontColor=#04342C;" value="&lt;b&gt;Signed order confirmation&lt;/b&gt;&lt;br&gt;and the shared record" vertex="1">
          <mxGeometry height="70" width="190" x="730" y="380" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;fontSize=12;fontColor=#3C3489;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="yes" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;fontSize=12;fontColor=#3C3489;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="no" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" edge="1" parent="1" source="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="done">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1220" y="145" />
              <mxPoint x="1220" y="415" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" edge="1" parent="1" source="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;fontSize=11;fontColor=#085041;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="done" value="approved">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#888780;fontSize=13;fontColor=#2C2C2A;" value="&lt;b&gt;Exceptions are never silent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Order deadline passed: refused, with what can arrive and when.&lt;br&gt;Partial stock: a split proposal, and a person decides.&lt;br&gt;Another brand or a substitute: always a person.&lt;br&gt;A rejected cart cannot be sent again.&lt;br&gt;Bad or missing data: no offer, never a guess." vertex="1">
          <mxGeometry height="160" width="560" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="eg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#888780;fontSize=13;fontColor=#2C2C2A;" value="&lt;b&gt;Example from the live mock data&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;I need 1,000 litres of lactose free milk by Monday.&quot;&lt;br&gt;Best offer: Valio Arki Eila 1 l, 1.01 EUR per litre.&lt;br&gt;Total 1,010.00 EUR ex VAT: over the 500 EUR limit.&lt;br&gt;The main user approves on the phone. Order signed and recorded.&lt;br&gt;20 litres (20.20 EUR): the agent orders with no person." vertex="1">
          <mxGeometry height="160" width="560" x="640" y="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 What Valio Aimo sees" id="ins">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ins1" value="What Valio Aimo learns from agent orders" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ins2" value="Every step writes one record. A buyer sees its own record. Valio Aimo staff see all buyers, read only." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ins3" value="&lt;b&gt;Buyer agents&lt;/b&gt;&lt;br&gt;Any agent, any buyer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ins4" value="&lt;b&gt;Main users&lt;/b&gt;&lt;br&gt;Approve, reject, set limits" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ins5" value="&lt;b&gt;Valtuus gateway&lt;/b&gt;&lt;br&gt;Search, offers, carts, decisions, orders, approvals, refusals" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="210" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ins6" value="&lt;b&gt;Shared record&lt;/b&gt;&lt;br&gt;Append only. One plain sentence per step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ins7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ins3" target="ins5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ins8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ins4" target="ins5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ins9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ins5" target="ins6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ins10" value="Valio Aimo console (staff, read only)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="580" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ins11" value="&lt;b&gt;Orders from agents&lt;/b&gt;&lt;br&gt;&amp;#8226; Which buyer and which agent&lt;br&gt;&amp;#8226; Automatic, or approved by whom&lt;br&gt;&amp;#8226; Total ex VAT and delivery date&lt;br&gt;&amp;#8226; Signature on every confirmation&lt;br&gt;&lt;br&gt;&lt;i&gt;Use: See how much agent ordering is worth&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="260" height="215" as="geometry" />
        </mxCell>
        <mxCell id="ins12" value="&lt;b&gt;Decisions and exceptions&lt;/b&gt;&lt;br&gt;&amp;#8226; Sent to a person, and why&lt;br&gt;&amp;#8226; Denied, rejected, expired&lt;br&gt;&amp;#8226; Every reason in plain words&lt;br&gt;&lt;br&gt;&lt;i&gt;Use: Find rules that stop good orders&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="260" height="215" as="geometry" />
        </mxCell>
        <mxCell id="ins13" value="&lt;b&gt;Unmet demand&lt;/b&gt;&lt;br&gt;&amp;#8226; Searches with no match&lt;br&gt;&amp;#8226; Products refused: deadline passed&lt;br&gt;&amp;#8226; Partial stock and substitutes&lt;br&gt;&lt;br&gt;&lt;i&gt;Use: Range gaps and stock planning&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="385" width="260" height="215" as="geometry" />
        </mxCell>
        <mxCell id="ins14" value="&lt;b&gt;Refused calls&lt;/b&gt;&lt;br&gt;&amp;#8226; Revoked agent keys&lt;br&gt;&amp;#8226; Calls with missing rights&lt;br&gt;&amp;#8226; An agent that tried to approve&lt;br&gt;&lt;br&gt;&lt;i&gt;Use: Find a broken or hostile agent early&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="385" width="260" height="215" as="geometry" />
        </mxCell>
        <mxCell id="ins15" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ins6" target="ins13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ins16" value="&lt;b&gt;The buyer sees&lt;/b&gt;&lt;br&gt;Its own orders, decisions and record. Nothing of other buyers." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ins17" value="&lt;b&gt;Valio Aimo staff see&lt;/b&gt;&lt;br&gt;All buyers, read only. Staff cannot approve, edit rules or order." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="540" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6 Trust chain" id="tru">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tru1" value="Six links: nobody has to trust the agent&#39;s reasoning" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tru2" value="Each link is a fact that the buyer and Valio Aimo can check after the order." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tru3" value="&lt;b&gt;1 Identity&lt;/b&gt;&lt;br&gt;The agent key is bound to one buyer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru4" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;Which agent, for which buyer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru5" value="&lt;b&gt;2 Authority&lt;/b&gt;&lt;br&gt;The main user sets the rules as typed values" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="228" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru6" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;The rule version on each order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="228" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru7" value="&lt;b&gt;3 True data&lt;/b&gt;&lt;br&gt;Each offer is signed: price, stock, deadline" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="416" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru8" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;Verify the signature any time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="416" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru9" value="&lt;b&gt;4 Commitment&lt;/b&gt;&lt;br&gt;Inside the rules the agent orders. Outside, a person" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="604" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru10" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;Automatic, or who approved" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="604" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru11" value="&lt;b&gt;5 Proof&lt;/b&gt;&lt;br&gt;The signed confirmation names agent, approver, rule version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="792" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru12" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;Verify the confirmation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="792" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru13" value="&lt;b&gt;6 Control&lt;/b&gt;&lt;br&gt;Change limits, revoke the agent, read the record" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="130" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tru14" value="&lt;b&gt;Valio Aimo can check&lt;/b&gt;&lt;br&gt;Every refusal is recorded" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tru15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tru3" target="tru5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tru16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tru5" target="tru7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tru17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tru7" target="tru9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tru18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tru9" target="tru11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tru19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=1;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tru11" target="tru13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tru20" value="&lt;b&gt;The claim&lt;/b&gt;&lt;br&gt;The buyer sets the limits and signs off. The agent gets data that it can check. Valio Aimo gets orders that it can accept." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=14;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1110" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
