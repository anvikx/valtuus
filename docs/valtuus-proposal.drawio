  <diagram name="1 Overview" id="ov">
    <mxGraphModel dx="1200" dy="1001" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#2C2C2A;fontStyle=1;" value="Any agent can buy from Valio Aimo. The buyer keeps control." vertex="1">
          <mxGeometry height="44" width="1160" x="40" y="18" as="geometry" />
        </mxCell>
        <mxCell id="ov2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" value="Valtuus: open to any agent, controlled by the buyer, auditable by both sides." vertex="1">
          <mxGeometry height="30" width="1160" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="ov3" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;dashed=1;" value="Buyers and their agents" vertex="1">
          <mxGeometry height="470" width="240" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ov4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;align=center;spacing=10;" value="&lt;b&gt;Kitchen staff&lt;/b&gt;&lt;br&gt;&quot;1,000 L lactose free milk by Monday&quot;" vertex="1">
          <mxGeometry height="90" width="200" x="60" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ov5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Their AI agent&lt;/b&gt;&lt;br&gt;External agents, integration" vertex="1">
          <mxGeometry height="90" width="200" x="60" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ov6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Main user&lt;/b&gt;&lt;br&gt;Sets the limits. Approves on the phone." vertex="1">
          <mxGeometry height="90" width="200" x="60" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ov7" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#04342C;" value="Valio Aimo, with Valtuus in front" vertex="1">
          <mxGeometry height="470" width="600" x="320" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ov8" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Your API says Monday. The deadline was Thursday.&lt;/b&gt;&lt;br&gt;3 products show a Monday date, but their order deadline passed. We refuse them and say what can arrive." vertex="1">
          <mxGeometry height="120" width="275" x="340" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ov9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Your webshop: 0 results&lt;/b&gt;&lt;br&gt;&quot;laktoositon maito&quot; gives 0 results. &quot;lactose free milk&quot; gives 67, and the first 7 are not milk. The agent finds the right product." vertex="1">
          <mxGeometry height="120" width="275" x="630" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ov10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;Valio Aimo systems&lt;/b&gt;&lt;br&gt;17,546 products. Price and stock APIs, called only for the candidates. Nothing changes inside Valio Aimo." vertex="1">
          <mxGeometry height="110" width="565" x="340" y="305" as="geometry" />
        </mxCell>
        <mxCell id="ov11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;1 Finds the product&lt;/b&gt;&lt;br&gt;Lactose free milk, from 17,546 products" vertex="1">
          <mxGeometry height="125" width="130" x="340" y="440" as="geometry" />
        </mxCell>
        <mxCell id="ov12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;2 Signed offer&lt;/b&gt;&lt;br&gt;Valio Arki Eila, 1.01 EUR per litre" vertex="1">
          <mxGeometry height="125" width="130" x="485" y="440" as="geometry" />
        </mxCell>
        <mxCell id="ov13" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;3 Buyer&#39;s rules&lt;/b&gt;&lt;br&gt;1,010 EUR is over the 500 EUR limit" vertex="1">
          <mxGeometry height="125" width="130" x="630" y="440" as="geometry" />
        </mxCell>
        <mxCell id="ov14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12;align=center;spacing=10;" value="&lt;b&gt;4 One tap&lt;/b&gt;&lt;br&gt;Approved on the phone. Order signed and recorded" vertex="1">
          <mxGeometry height="125" width="130" x="775" y="440" as="geometry" />
        </mxCell>
        <mxCell id="ov15" edge="1" parent="1" source="ov11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=3;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" target="ov12" value="">
          <mxGeometry relative="1" as="geometry" />
