  <diagram name="8 Path to production" id="pth">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pth1" value="From prototype to production" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#2C2C2A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pth2" value="The states and rules stay the same. Only what is behind each port changes." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pth3" value="&lt;b&gt;Today: prototype&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=15;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pth4" value="&lt;b&gt;Mock APIs and product files&lt;/b&gt;&lt;br&gt;Price and stock only for candidates" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth5" value="&lt;b&gt;Order in a prototype ledger&lt;/b&gt;&lt;br&gt;No order API in the mock" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="258" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth6" value="&lt;b&gt;Seeded logins, one approver&lt;/b&gt;&lt;br&gt;The main user" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="336" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth7" value="&lt;b&gt;Rules stored at the gateway&lt;/b&gt;&lt;br&gt;Versioned, not signed by the buyer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="414" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth8" value="&lt;b&gt;Signed with our own key&lt;/b&gt;&lt;br&gt;Shown as &quot;mock issuer&quot;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="492" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth9" value="&lt;b&gt;Next: on Valio Aimo systems&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=15;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pth10" value="&lt;b&gt;Real order API&lt;/b&gt;&lt;br&gt;Stock reservation, cancel, change" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth11" value="&lt;b&gt;Real identity&lt;/b&gt;&lt;br&gt;SSO and approval roles" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="258" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth12" value="&lt;b&gt;Notices&lt;/b&gt;&lt;br&gt;Push or email for an approval, callback for agents" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="336" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth13" value="&lt;b&gt;Rules per buyer type&lt;/b&gt;&lt;br&gt;Category limits, order days, school allergens" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="414" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth14" value="&lt;b&gt;Console reports&lt;/b&gt;&lt;br&gt;Unmet demand, share of agent orders" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="492" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth15" value="&lt;b&gt;Later: open standards&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=15;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pth16" value="&lt;b&gt;Mandate signed by the buyer&lt;/b&gt;&lt;br&gt;The buyer&#39;s platform owns it, Valio Aimo verifies" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth17" value="&lt;b&gt;Map to AP2&lt;/b&gt;&lt;br&gt;Intent and cart mandates, no change of states" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="258" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth18" value="&lt;b&gt;Approval cards in agent apps&lt;/b&gt;&lt;br&gt;MCP Apps" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="336" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth19" value="&lt;b&gt;Product claims as credentials&lt;/b&gt;&lt;br&gt;GS1 and W3C" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="414" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth20" value="&lt;b&gt;Hash chain on the record&lt;/b&gt;&lt;br&gt;Tampering becomes visible" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#534AB7;fontColor=#2C2C2A;fontSize=12;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="492" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pth21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0F6E56;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pth3" target="pth9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pth22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#534AB7;strokeWidth=2;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pth9" target="pth15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pth23" value="We never call the prototype AP2 or UCP compliant." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="1100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="9 System architecture" id="arch">
    <mxGraphModel dx="1065" dy="889" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1090" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ar1" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#2C2C2A;fontStyle=1;" value="System architecture: protocols and standards" vertex="1">
          <mxGeometry height="44" width="1160" x="40" y="18" as="geometry" />
        </mxCell>
        <mxCell id="ar2" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5F5E5A;" value="Two doors, one set of rules. Solid boxes are built. Dashed boxes are planned." vertex="1">
          <mxGeometry height="30" width="1160" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="ar_buyer" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Buyer (chef)&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="300" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ar_main" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Main user (manager)&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="300" x="880" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ar_agent" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;" value="&lt;b&gt;Buyer&#39;s agent&lt;/b&gt;&lt;br&gt;Claude Code or any MCP client" vertex="1">
          <mxGeometry height="70" width="300" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="ar_any" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Any client&lt;/b&gt;&lt;br&gt;Scripts and other systems. No AI needed" vertex="1">
          <mxGeometry height="70" width="280" x="516" y="190" as="geometry" />
        </mxCell>
        <mxCell id="ar_web" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;" value="&lt;b&gt;Valtuus web app&lt;/b&gt;&lt;br&gt;React. Approve, set limits, read the record" vertex="1">
          <mxGeometry height="70" width="300" x="880" y="220" as="geometry" />
        </mxCell>
        <mxCell id="ar_gw" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#04342C;" value="Valtuus gateway (FastAPI, Python 3.12)" vertex="1">
          <mxGeometry height="300" width="1160" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ar_mcp" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;MCP door  /api/mcp&lt;/b&gt;&lt;br&gt;Streamable HTTP, JSON-RPC 2.0" vertex="1">
          <mxGeometry height="60" width="460" x="70" y="420" as="geometry" />
        </mxCell>
        <mxCell id="ar_rest" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;REST door  /api/v1&lt;/b&gt;&lt;br&gt;JSON over HTTPS. OpenAPI 3.1 at /api/openapi.json" vertex="1">
          <mxGeometry height="60" width="570" x="600" y="420" as="geometry" />
        </mxCell>
        <mxCell id="ar_srv" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Services, one set for both doors&lt;/b&gt;&lt;br&gt;Catalog search, offers, cart, checkout, approval, mandate, audit" vertex="1">
          <mxGeometry height="64" width="1100" x="70" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ar_pol" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Policy engine: rules in code, no LLM&lt;/b&gt;&lt;br&gt;Automatic orders switch, order limit, daily limit. Every step writes an audit record" vertex="1">
          <mxGeometry height="64" width="1100" x="70" y="584" as="geometry" />
        </mxCell>
        <mxCell id="ar_pg" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;Mandates, offers, carts, orders, audit, products" vertex="1">
          <mxGeometry height="80" width="320" x="60" y="770" as="geometry" />
        </mxCell>
        <mxCell id="ar_file" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Valio Aimo product file&lt;/b&gt;&lt;br&gt;17,546 products with GS1 attributes (claims, allergens)" vertex="1">
          <mxGeometry height="80" width="320" x="460" y="770" as="geometry" />
        </mxCell>
        <mxCell id="ar_valio" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Valio Aimo API (mock)&lt;/b&gt;&lt;br&gt;POST /api/price and /api/availability, 1 to 1,000 ids per call" vertex="1">
          <mxGeometry height="80" width="340" x="860" y="770" as="geometry" />
        </mxCell>
        <mxCell id="ar_std" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#2C2C2A;fontSize=13;" value="&lt;b&gt;Shared standards:&lt;/b&gt; ISO 8601 times (Europe/Helsinki) · EUR as exact decimal strings · HTTPS with TLS by Caddy · Docker Compose, deployed by GitHub Actions" vertex="1">
          <mxGeometry height="56" width="1160" x="40" y="890" as="geometry" />
        </mxCell>
        <mxCell id="ar_p1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;dashed=1;fontColor=#2C2C2A;fontSize=12;" value="&lt;b&gt;Planned: signed offers and orders&lt;/b&gt;&lt;br&gt;JWS (RFC 7515), EdDSA Ed25519 (RFC 8037), public keys at /.well-known/jwks.json (RFC 7517). Today: Not signed yet" vertex="1">
