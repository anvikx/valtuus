        <mxCell id="gRecord" value="&lt;b&gt;Shared record&lt;/b&gt;&lt;br&gt;Every step in plain words" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FE1CB;strokeColor=#0F6E56;fontSize=12;fontColor=#04342C;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="cValio" value="Valio Aimo systems" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="280" height="420" as="geometry" />
        </mxCell>
        <mxCell id="vData" value="&lt;b&gt;Product data&lt;/b&gt;&lt;br&gt;17,546 products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="890" y="160" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="vPrice" value="&lt;b&gt;Price and availability API&lt;/b&gt;&lt;br&gt;Only for the candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="890" y="230" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="vOrder" value="&lt;b&gt;Order system&lt;/b&gt;&lt;br&gt;Next step: a real order API" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#888780;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="890" y="370" width="220" height="56" as="geometry" />
