          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" edge="1" parent="1" source="gOffer" target="vPrice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="next step" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#888780;fontSize=11;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gDecide" target="vOrder">
          <mxGeometry relative="1" as="geometry" />
