# A deploy restarts the backend and it is not reachable for about 15 s. Caddy holds the
# request and dials again until this time ends, so the caller does not get a 502. A POST
# is tried again only when the dial failed, so the backend never gets it twice.
(backend_restart) {
	lb_try_duration 30s
}

# SITE_ADDRESS=example.com gives automatic HTTPS. Default :80 serves plain HTTP for local use.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		# Flush at once so SSE streams are not buffered.
		reverse_proxy backend:8000 {
			flush_interval -1
			import backend_restart
		}
	}

	# Agents fetch the signing keys and the discovery file at fixed root paths.
	# Only these two go to the backend. Keep in sync with backend/tests/test_routes.py.
	@well_known path /.well-known/jwks.json /.well-known/agent-trade.json
	handle @well_known {
		reverse_proxy backend:8000 {
			import backend_restart
		}
	}

	# SPA: unknown paths fall back to index.html for client routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
