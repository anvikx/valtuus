# Copy to .env. On the server, .env lives in DEPLOY_PATH and is never committed.

# Domain for automatic HTTPS, for example app.example.com. Empty means plain HTTP on :80.
SITE_ADDRESS=

# Backend settings (app/config.py). Field names map to upper case env vars.
APP_NAME=junction-2026

VALIO_BASE_URL=https://junction26.valioaimo.fi/api
VALIO_API_KEY=<valio key>
AGENT_KEY=<auth key>
# Login of the hotel main user on the approve page.
MAIN_USER_PASSWORD=<main user password>
# Signs offers and order confirmations (Ed25519): `openssl rand -base64 32`. Empty means
# unsigned. Keep it across deploys: a new key makes the old signatures uncheckable.
SIGNING_PRIVATE_KEY=

# Postgres. Compose builds DATABASE_URL from it, so use a URL safe password, for example
# from `openssl rand -hex 24`. The db container sets it only on the first start of an
# empty volume; later changes need ALTER USER.
POSTGRES_PASSWORD=<db password>
